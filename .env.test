# ค่า dummy สำหรับ "รันเทส" เท่านั้น — ไม่ใช่ความลับ และห้ามใส่ค่าจริงลงไฟล์นี้
#
# ทำไมต้องมี: เทสบางชุด (conditionSets, generationTemplates, perModelConditionSets)
# import โมดูลที่ลากไปถึง src/api/firebase.ts ซึ่งเรียก initializeApp() + getDatabase()
# ตอน import — ไม่มี VITE_FIREBASE_DATABASE_URL เมื่อไหร่ suite ล้มทั้งไฟล์ตั้งแต่ตอนโหลด
#
# เดิมค่าพวกนี้มาจากไฟล์ `.env` ที่ถูก commit ไว้ในรีโป แปลว่า **การรันเทสทุกครั้ง
# ใช้ config ของ Firebase ตัวจริง (production)** ซึ่งไม่ใช่สิ่งที่เทสควรทำ พอถอด `.env`
# ออกจาก tracking (ดูเหตุผลใน .gitignore) เทสจึงต้องมีค่าของตัวเอง
#
# Vite โหลด `.env.[mode]` และให้ค่ามันชนะ `.env` — vitest รันด้วย mode `test`
# ไฟล์นี้จึงถูกใช้ทั้งใน CI และบนเครื่อง dev ที่มี `.env` จริงอยู่ ผลคือเทสได้ config
# ชุดเดียวกันทุกที่ และไม่มีทางไปแตะโปรเจกต์จริงโดยบังเอิญ
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=bkk-test.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://bkk-test-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=bkk-test
VITE_FIREBASE_STORAGE_BUCKET=bkk-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_GOOGLE_MAPS_API_KEY=test-maps-key
VITE_FIREBASE_VAPID_KEY=test-vapid-key
